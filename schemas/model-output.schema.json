{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygo-bench.org/schemas/model-output.schema.json",
  "title": "YGO-Bench model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "record_id",
    "attempt",
    "status",
    "model",
    "harness",
    "latency_ms",
    "usage",
    "audit"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "record_id": {"$ref": "#/$defs/id"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["ok", "parser_error", "timeout", "refusal", "provider_error"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "revision", "inference_mode"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "inference_mode": {"enum": ["local", "api", "non_llm"]},
        "quantization": {"type": ["string", "null"]}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "legal_actions",
        "snapshot_rag",
        "checker",
        "memory_planner"
      ],
      "properties": {
        "condition": {"enum": ["C1", "C2", "C3", "custom"]},
        "legal_actions": {"enum": ["hidden", "shown"]},
        "snapshot_rag": {"type": "boolean"},
        "checker": {"type": "boolean"},
        "memory_planner": {"type": "boolean"},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "answer": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_ms": {"type": "number", "minimum": 0},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_count", "repair_count", "fallback_used", "actors"],
      "properties": {
        "retry_count": {"type": "integer", "minimum": 0},
        "repair_count": {"type": "integer", "minimum": 0},
        "fallback_used": {"type": "boolean"},
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "operation"],
            "properties": {
              "actor": {
                "enum": ["model", "engine", "retriever", "checker", "planner", "controller"]
              },
              "operation": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "raw_response_sha256": {"$ref": "#/$defs/sha256"},
    "provider_request_id": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"required": ["answer"]},
      "else": {
        "required": ["error"],
        "properties": {"error": {"type": "string", "minLength": 1}}
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
